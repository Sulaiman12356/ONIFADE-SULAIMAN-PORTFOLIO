rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ipesolasulaiman@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Public portfolio collections: read by all, write by admin only
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /caseStudies/{caseStudyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brandProjects/{brandProjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialProjects/{socialProjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{educationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certifications/{certificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cv/{cvId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Interactive collections: public visitors can create leads/inquiries, only admin can manage
    match /hireRequests/{requestId} {
      allow create: if (request.resource.data.name is string || request.resource.data.fullName is string || request.resource.data.clientName is string) &&
                       (request.resource.data.email is string || request.resource.data.clientEmail is string);
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow create: if request.resource.data.eventType is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
